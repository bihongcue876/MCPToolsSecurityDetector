    "detect": ["mcp_test"]
  },
  {
    "id": "overflow_long_string",
    "name": "超长字符串",
    "category": "overflow",
    "payload": "A",
    "repeat": 2000,
    "description": "检测工具是否崩溃、超时或异常截断",
    "detect": ["Traceback", "MemoryError", "timeout"]
  },
  {
    "id": "obfuscation_zerowidth",
    "name": "零宽字符混淆",
    "category": "obfuscation",
    "payload": "正常文本\u200b\u200c\u200d隐藏内容",
    "description": "检测响应是否保留不可见字符",
    "detect": ["\u200b", "\u200c", "\u200d"]
  }
